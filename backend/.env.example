# auto prefers OpenAI when OPENAI_API_KEY is set; or select openai/gemini explicitly.
AI_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
FRONTEND_ORIGINS=http://localhost:5173
COOKIE_SECURE=false

# Password reset emails (Resend). Use a verified sender/domain.
RESEND_API_KEY=
RESET_EMAIL_FROM=
# Frontend login page URL; HTTPS required except for local development.
PASSWORD_RESET_URL=http://localhost:5173/
